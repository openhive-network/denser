# Hive mainnet (the default): DENSER_NETWORK=mainnet
REACT_APP_API_ENDPOINT=https://api.syncad.com
REACT_APP_CHAIN_ID=beeab0de00000000000000000000000000000000000000000000000000000000
REACT_APP_AI_DOMAIN=https://api.syncad.com
REACT_APP_ALLOWED_HIVE_API_NODES=https://api.syncad.com https://api.hive.blog https://api.openhive.network https://images.hive.blog
