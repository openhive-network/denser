{
  "name": "@hive/blog",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "clean": "rm -rf ./public/auth/* && rm -rf ./public/locales/* && rm -rf ./public/smart-signer/*",
    "copy:worker": "cp ../../node_modules/@hiveio/hb-auth/dist/worker.js ./public/auth/",
    "copy:assets": "cp -r ../../node_modules/@hiveio/hb-auth/dist/assets ./public/auth/assets",
    "predev": "pnpm run clean",
    "dev": "react-env -- next dev -H 0.0.0.0 -p 3000",
    "dev:3010": "react-env -- next dev -H 0.0.0.0 -p 3010",
    "devssl": "react-env -- next dev -H 0.0.0.0 --port 3000 --experimental-https --experimental-https-key ../../ssl/server-key.pem --experimental-https-cert ../../ssl/server-cert.pem",
    "prebuild": "pnpm run clean",
    "build": "react-env -- next build",
    "postbuild": "pnpm run copy:worker && pnpm run copy:assets",
    "start": "react-env -- next start -p 3000",
    "start:standalone": "rm -rf .next/standalone/apps/blog/.next/static .next/standalone/apps/blog/public && cp -r .next/static .next/standalone/apps/blog/.next/static && cp -r public .next/standalone/apps/blog/public && react-env -- node .next/standalone/apps/blog/server.js",
    "lint": "eslint .",
    "lint:translations": "node ../../scripts/check-blog-translations.js",
    "lint:translations:usage": "node ../../scripts/check-blog-translation-usage.js",
    "pw:test:local": "playwright test --config=playwright.local3000.config.ts  --update-snapshots",
    "pw:test:local:chromium": "playwright test --project=chromium --config=playwright.local3000.config.ts --headed  --update-snapshots",
    "pw:test:local:firefox": "playwright test --project=firefox --config=playwright.local3000.config.ts --headed  --update-snapshots",
    "pw:test:local:webkit": "playwright test --project=webkit --config=playwright.local3000.config.ts --headed  --update-snapshots",
    "pw:test:local:experimental:ui": "playwright test --config=playwright.local3000.config.ts --ui",
    "pw:blog:test:mir:chromium": "playwright test --project=chromium --config=playwright.stack-mirrornet-3000.config.ts --update-snapshots",
    "pw:blog:test:mir:chromium:trace": "playwright test --project=chromium --config=playwright.stack-mirrornet-3000.config.ts --update-snapshots --trace on",
    "pw:blog:test:mir:chromium:ui": "playwright test --project=chromium --config=playwright.stack-mirrornet-3000.config.ts --update-snapshots --ui",
    "pw:blog:test:mir:chromium:container:local": "playwright test --project=chromium --config=playwright.stack-mirrornet-local-3000.config.ts --headed --update-snapshots",
    "pw:blog:test:mir:chromium:ui:container:local": "playwright test --project=chromium --config=playwright.stack-mirrornet-local-3000.config.ts --update-snapshots --ui",
    "pw:blog:test:mir:chromium:container13:local": "playwright test --project=chromium --config=playwright.stack-mirrornet-local-3000-13.config.ts --headed --update-snapshots",
    "pw:blog:test:mir:chromium:ui:container13:local": "playwright test --project=chromium --config=playwright.stack-mirrornet-local-3000-13.config.ts --update-snapshots --ui",
    "test:mock": "playwright test --config=playwright.mock.config.ts",
    "test:mock:headed": "playwright test --config=playwright.mock.config.ts --headed",
    "test:fixture:prepare": "../../scripts/write-version.sh ./version.json && pnpm build",
    "test:fixture": "pnpm run test:fixture:prepare && playwright test --config=playwright.fixture.config.ts",
    "test:fixture:headed": "pnpm run test:fixture:prepare && playwright test --config=playwright.fixture.config.ts --headed",
    "test:fixture:record": "pnpm run test:fixture:prepare && FIXTURE_MODE=record playwright test --config=playwright.fixture.config.ts"
  },
  "dependencies": {
    "@beam-australia/react-env": "^3.1.1",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.13",
    "@hive/eslint-config-custom": "workspace:*",
    "@hive/middleware": "workspace:*",
    "@hive/prettier-config-custom": "workspace:*",
    "@hive/renderer": "workspace:*",
    "@hive/smart-signer": "workspace:*",
    "@hive/tailwindcss-config": "workspace:*",
    "@hive/transaction": "workspace:*",
    "@hive/tsconfig": "workspace:*",
    "@hive/ui": "workspace:*",
    "@hiveio/healthchecker-component": "catalog:hiveio-toolset",
    "@hiveio/wax": "catalog:hiveio-toolset",
    "@hookform/resolvers": "^3.10.0",
    "@next/bundle-analyzer": "^14.2.2",
    "@sentry/nextjs": "^10",
    "@tanstack/react-query": "^4.36.1",
    "@types/big.js": "^6.2.2",
    "@types/node": "20.10.4",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@types/remarkable": "^2.0.8",
    "@types/sanitize-html": "^2.9.5",
    "big.js": "^6.2.1",
    "class-variance-authority": "^0.6.1",
    "clsx": "^1.2.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "framer-motion": "^12.23.12",
    "googleapis": "^170.0.0",
    "heic2any": "^0.0.4",
    "hive-auth-client": "^0.1.5",
    "http-errors": "^2.0.0",
    "i": "^0.3.7",
    "i18next": "^23.7.9",
    "i18next-resources-to-backend": "^1.2.1",
    "iron-session": "^8.0.1",
    "lucide-react": "^0.482.0",
    "next": "^14.2.5",
    "next-i18next": "^15.1.1",
    "next-themes": "^0.2.1",
    "next-transpile-modules": "^10.0.1",
    "pino": "^8.17.1",
    "playwright-merge-html-reports": "^0.2.8",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "qrcode": "^1.5.3",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "react-hook-form": "^7.49.2",
    "react-intersection-observer": "^9.5.2",
    "react-spinners-kit": "^1.9.1",
    "remarkable": "^2.0.1",
    "sanitize-html": "^2.11.0",
    "simple-zustand-devtools": "^1.1.0",
    "tailwind-merge": "^1.13.2",
    "usehooks-ts": "^3.1.0",
    "yet-another-react-lightbox": "^3.15.6",
    "zod": "^3.25.76",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "@tanstack/react-query-devtools": "^4.36.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-http-proxy": "^1.6.7",
    "@types/http-errors": "^2.0.4",
    "@types/qrcode": "^1.5.5",
    "@types/yazl": "^2.4.5",
    "copy-webpack-plugin": "^11.0.0",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "null-loader": "^4.0.1",
    "typescript": "5.3.3"
  }
}
