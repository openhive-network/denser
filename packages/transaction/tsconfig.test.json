{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["mocha", "node", "chai"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@hiveio/wax": ["lib/__test-stubs__/hiveio-wax.ts"],
      "@hive/common-hiveio-packages": ["lib/__test-stubs__/common-hiveio-packages.ts"],
      "@hive/common-hiveio-packages/wax": ["lib/__test-stubs__/common-hiveio-packages-wax.ts"],
      "@hive/ui/lib/logging": ["lib/__test-stubs__/ui-logging.ts"],
      "@ui/lib/logging": ["lib/__test-stubs__/ui-logging.ts"],
      "@ui/lib/api-node-preference": ["lib/__test-stubs__/ui-api-node-preference.ts"]
    }
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
