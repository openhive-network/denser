# Copy to .env next to compose.yml and fill in. .env is not committed.
COMPOSE_PROJECT_NAME=denser-integration

# The hostname the site answers (blog at /blog, wallet at /wallet). On
# predicate-testing, *.discuss.peerverity.info already resolves (internally and
# publicly) to the sites-router.
SITE_HOST=denser.discuss.peerverity.info

# mainnet (default) or mirrornet; see networks/.
DENSER_NETWORK=mainnet

# Image tag to run: integration follows every AIDEV promote.
DENSER_TAG=integration

# Behind sites-router: caddy on an unused loopback address, PROXY protocol from
# the router only.
HTTP_PORT=127.0.0.4:80
HTTPS_PORT=127.0.0.4:443
CADDY_PROXY_PROTOCOL_ALLOW=172.31.201.2/32
PROXY_NETWORK=sites

# Secrets.
CLOUDFLARE_API_TOKEN=
DENSER_SERVER_SECRET_COOKIE_PASSWORD=
