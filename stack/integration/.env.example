# Copy to .env next to compose.yml and fill in. .env is not committed.
COMPOSE_PROJECT_NAME=denser-integration

# The hostname the site answers (blog at /blog, wallet at /wallet). On
# predicate-testing, *.discuss.peerverity.info already resolves (internally and
# publicly) to the sites-router.
SITE_HOST=denser.discuss.peerverity.info

# mainnet (default) or mirrornet; see networks/.
DENSER_NETWORK=mainnet

# follow (default): serve production builds of this checkout, fast-forwarded to
# DENSER_SOURCE_BRANCH and rebuilt where the code changed (compose.follow.yml).
# images: run the published images at DENSER_TAG instead (compose.yml alone).
DENSER_MODE=follow
DENSER_SOURCE_BRANCH=aidev/integration
# Image tag to run in images mode, e.g. a published <sha8> to pin a version.
DENSER_TAG=integration

# The shared HTML cache in front of the blog (compose.cache.yml): varnish, or off
# (default). See README.md, "Shared HTML cache".
#DENSER_HTML_CACHE=varnish
#DENSER_HTML_CACHE_SIZE=256M

# The account lighthouse.sh reads logged-in pages as (default blocktrades: a large
# history). Only its name is used: the check stores no key.
#LIGHTHOUSE_OBSERVER=blocktrades

# Behind sites-router: caddy on an unused loopback address, PROXY protocol from
# the router only.
HTTP_PORT=127.0.0.4:80
HTTPS_PORT=127.0.0.4:443
CADDY_PROXY_PROTOCOL_ALLOW=172.31.201.2/32
PROXY_NETWORK=sites

# Secrets.
CLOUDFLARE_API_TOKEN=
DENSER_SERVER_SECRET_COOKIE_PASSWORD=
# The `denser` OAuth client's secret (32+ random characters), the one openhive.chat
# is configured with; upgrade.sh's oauth check needs the client registered.
DENSER_SERVER_OAUTH_OPENHIVE_CHAT_SECRET=
# Chat in Matrix mode (optional, see ../matrix/README.md); unset keeps openhive.chat
CHAT_PROVIDER=
MATRIX_ELEMENT_URL=
MATRIX_HOMESERVER_URL=
DENSER_SERVER_OAUTH_MATRIX_SECRET=
# Optional: the room the drawer opens in (default #general:<homeserver host>), and a Synapse
# admin's access token for deleting a user's Matrix devices at sign-out (empty: never)
MATRIX_DEFAULT_ROOM=
DENSER_SERVER_MATRIX_ADMIN_TOKEN=
# The drawer's client: native (default; signs in with login tokens minted with the admin token
# above) or element (Element in an iframe)
MATRIX_CHAT_CLIENT=
# yes: authenticate sign-ins on the server; Matrix chat and its OAuth sign-in need it
LOGIN_AUTHENTICATE_ON_BACKEND=
# For You feed (optional): the haf_fyp API, e.g. https://api.syncad.com/haf-fyp-api. Empty keeps it off.
#FYP_API_URL=
# Google Drive sign-in (optional): a Google OAuth web client whose authorized
# JavaScript origin is https://<SITE_HOST>. Leave empty to keep the method disabled.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
