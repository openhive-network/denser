# Lite accounts (reply without a Hive account): the blog proxies /api/lite-reply to a
# lite-account gateway (hive/lite_gateway). Default: the public instance. A node running
# its own gateway points here at it; an empty value disables the feature.
# DENSER_SERVER_LITE_GATEWAY_URL=https://api.hive.blog/lite-gateway-api

# Passkey signer sites a lite account can be secured with (hive-passkey-signer): a JSON array or a
# comma-separated list of origins. One: used without asking; several: the guest picks one.
# The signer opens as a popup, so no CSP entry is needed. Default: ["https://signer.hive.blog"].
# REACT_APP_PASSKEY_SIGNERS=["https://signer.hive.blog"]
