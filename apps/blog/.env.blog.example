
# Lite-account relay (server-only). Unset = relay disabled (POST /api/lite-reply -> 503).
# DENSER_SERVER_LITE_GATE_ACCOUNT=my-gate-account
# DENSER_SERVER_LITE_GATE_POSTING_WIF=5K...
# DENSER_SERVER_LITE_CHAIN_ID=beeab0de00000000000000000000000000000000000000000000000000000000
# DENSER_SERVER_LITE_MAX_EXPIRATION_MIN=60
# On-chain namespace (custom_json ids). Leave unset for the release ids; set a test
# namespace on test deployments so release apps never see test data.
# DENSER_SERVER_LITE_ACCOUNT_APP=lite_account_test
# DENSER_SERVER_LITE_POSTS_APP=lite_posts_test
