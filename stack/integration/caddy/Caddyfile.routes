# The routes of hive/haf_api_node's caddy/Caddyfile.tmpl for the `ui` profile,
# imported by the integration site (Caddyfile) and a session stack (Caddyfile.session).

# /<app>/_next/static/*: Caddyfile.static.releases (follow mode) or
# Caddyfile.static.next (images mode), as DENSER_STATIC_FROM says.
import Caddyfile.static.{$DENSER_STATIC_FROM:next} blog
import Caddyfile.static.{$DENSER_STATIC_FROM:next} wallet

# A test deployment mirroring hive.blog's content: keep crawlers out, as
# new.hive.blog and wallet.hive.blog do. Answered here, not by an app, and under
# each app's prefix too in case a crawler asks there.
@robots path /robots.txt /blog/robots.txt /wallet/robots.txt
handle @robots {
	header Content-Type "text/plain; charset=utf-8"
	respond <<TXT
		User-agent: *
		Disallow: /
		TXT 200
}

# lb_try_duration: while an app's server restarts (follow mode swapping in a new
# build, or a container being recreated) a request waits for it rather than failing.
# DENSER_BLOG_UPSTREAM is varnish:80 when the shared HTML cache runs (compose.cache.yml).
handle /blog {
	reverse_proxy {$DENSER_BLOG_UPSTREAM:blog:80} {
		lb_try_duration 15s
	}
}
handle /blog/* {
	reverse_proxy {$DENSER_BLOG_UPSTREAM:blog:80} {
		lb_try_duration 15s
	}
}
handle /wallet {
	reverse_proxy wallet:80 {
		lb_try_duration 15s
	}
}
handle /wallet/* {
	reverse_proxy wallet:80 {
		lb_try_duration 15s
	}
}

# What runs here: commit, builds and their state, rewritten by upgrade.sh (or, in a
# session stack, by the follower).
handle_path /status/* {
	root * /srv/status
	file_server
}

handle /status {
	redir * /status/ 302
}

# A wallet.hive.blog link with only the host changed opens the same page under
# /wallet: the wallet's top-level pages (apps/wallet/app) and the account tabs only
# it has. /@user itself and the tabs both apps have (communities) stay the blog's.
# The matcher compares the unescaped path, so /%7Ewitnesses and /%40user match too.
@wallet {
	path /market /proposals /recovery_step_1 /~witnesses
	path /@*/author-rewards /@*/authorities /@*/curation-rewards /@*/delegations
	path /@*/password /@*/permissions /@*/transfers /@*/wallet
}
handle @wallet {
	redir * /wallet{uri} 302
}

# Any other path is the blog's: a hive.blog link with only the host changed opens
# the same page under /blog. {uri} keeps the query string.
handle / {
	redir * /blog 302
}
handle {
	redir * /blog{uri} 302
}
