# One instance per site directory (the escaped path of stack/integration):
#   inst=$(systemd-escape --path /home/syncad/denser-integration/stack/integration)
#   sudo systemctl enable --now "denser-integration-upgrade@${inst}.timer"
[Unit]
Description=Upgrade the denser integration site in %f
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=syncad
Group=syncad
WorkingDirectory=%f
ExecStart=%f/upgrade.sh --quiet
# compose's 300 s readiness wait, plus a Lighthouse check after a promote: up to 300 s
# waiting for the deploy, then 18 runs of at most 120 s each (about 7 minutes in practice).
TimeoutStartSec=3000
