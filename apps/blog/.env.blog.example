# Lite accounts (reply without a Hive account): the blog proxies /api/lite-reply to a
# lite-account gateway (hive/lite_gateway). Default: none — unset or empty leaves guest posting
# off and the blog makes no gateway request. Set it to enable the feature, e.g.:
# DENSER_SERVER_LITE_GATEWAY_URL=https://<gateway host>/lite-gateway-api

# Passkey signer sites a lite account can be secured with (hive-passkey-signer): a JSON array or a
# comma-separated list of origins. One: used without asking; several: the guest picks one.
# The signer opens as a popup, so no CSP entry is needed. Default: none — unset, empty or with no
# valid origin, no passkey is offered (no "Passkey signer" sign-in, no lite passkey securing), e.g.:
# REACT_APP_PASSKEY_SIGNERS=["https://<signer host>"]
