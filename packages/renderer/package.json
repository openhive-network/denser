{
  "name": "@hive/renderer",
  "version": "0.0.0-development",
  "description": "Content renderer for Hive posts and comments. Markdown + HTML",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "unpkg": "dist/browser/hive-content-renderer.min.js",
  "engines": {
    "node": ">=22.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint ./src --ext .js,.jsx,.ts,.tsx --fix",
    "test": "mocha 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.11",
    "ow": "3.1.1",
    "pino": "^10.3.0",
    "remarkable": "2.0.1",
    "sanitize-html": "2.17.0",
    "typescript-chained-error": "1.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@engrave/eslint-config-engrave": "1.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.2",
    "@hive/tsconfig": "workspace:*",
    "@semantic-release/gitlab": "13.2.9",
    "@types/chai": "5.2.3",
    "@types/jsdom": "27.0.0",
    "@types/lodash": "4.17.23",
    "@types/mocha": "10.0.10",
    "@types/node": "25.1.0",
    "@types/remarkable": "2.0.8",
    "@types/sanitize-html": "2.16.0",
    "chai": "6.2.2",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "lodash": "4.17.23",
    "mocha": "11.7.5",
    "tsx": "4.19.2",
    "nyc": "17.1.0",
    "prettier": "3.8.1",
    "semantic-release": "25.0.2",
    "ts-loader": "^9.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1",
    "webpack-visualizer-plugin2": "2.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        0
      ],
      "scope-case": [
        0
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.syncad.com/hive/hive-renderer.git"
  },
  "keywords": [
    "hive",
    "markdown",
    "renderer",
    "blockchain",
    "hive",
    "content",
    "content-renderer"
  ],
  "author": "Engrave (https://engrave.dev/)",
  "contributors": [
    "Jędrzej Lewandowski <jedrzejblew@gmail.com> (https://jedrzej.lewandowski.doctor/)",
    "Bartłomiej Górnicki <contact@engrave.dev> (https://engrave.dev)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.syncad.com/hive/hive-renderer/-/issues"
  },
  "homepage": "https://hive.io",
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/gitlab",
      "@semantic-release/npm"
    ]
  }
}
