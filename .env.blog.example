# Denser Blog Environment Configuration
# Copy to ~/.denser/.env.blog and fill in secrets
#
# IMPORTANT: Secrets (SECRET_COOKIE_PASSWORD, OIDC_COOKIES_KEYS) should be
# different from wallet for defense in depth. Generate unique values for each.

# =============================================================================
# App Identity (MUST differ between blog and wallet)
# =============================================================================
REACT_APP_APP_NAME="blog"
REACT_APP_SITE_DOMAIN="https://blog.openhive.network"
REACT_APP_APP_SESSION_TIME=64800

## Note: Those are the default Hive API nodes, you can modify them as needed.
## If you do not provide this variable, those default nodes will be used as a fallback. List is space & comma separated.
REACT_APP_ALLOWED_HIVE_API_NODES="https://api.hive.blog https://api.syncad.com https://api.openhive.network https://images.hive.blog"

# =============================================================================
# Hive Blockchain
# =============================================================================
REACT_APP_API_ENDPOINT="https://api.hive.blog"
REACT_APP_CHAIN_ID="beeab0de00000000000000000000000000000000000000000000000000000000"
# Base URL for image proxy service (no trailing slash)
REACT_APP_IMAGES_ENDPOINT="https://images.hive.blog"

# =============================================================================
# Related Services
# =============================================================================
REACT_APP_WALLET_ENDPOINT="https://wallet.openhive.network"
REACT_APP_BLOG_DOMAIN="https://blog.openhive.network"
REACT_APP_EXPLORER_DOMAIN="https://explore.openhive.network"
REACT_APP_AI_DOMAIN="https://api.syncad.com"

# =============================================================================
# Authentication
# =============================================================================
REACT_APP_ALLOW_NON_STRICT_LOGIN="yes"
REACT_APP_LOGIN_AUTHENTICATE_ON_BACKEND="no"

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=production
DENSER_SERVER_ENV_DUMP=false
DENSER_SERVER_API_CORS_ALLOW_ORIGIN="false"

# REQUIRED: Generate with: openssl rand -base64 32
# Must be unique - do not share with wallet
DENSER_SERVER_SECRET_COOKIE_PASSWORD="CHANGE_ME_GENERATE_UNIQUE_SECRET"

# =============================================================================
# OIDC (OpenID Connect)
# =============================================================================
DENSER_SERVER_OIDC_ENABLED="yes"

# REQUIRED: Generate with: openssl rand -base64 32
# Must be unique - do not share with wallet
DENSER_SERVER_OIDC_COOKIES_KEYS="CHANGE_ME_GENERATE_UNIQUE_SECRET"

# =============================================================================
# OpenHive Chat Integration (Rocket.Chat Widget)
# =============================================================================
# The chat widget appears as a floating button (lower-right) for logged-in users.
# Users must have granted OAuth consent to openhive_chat to see the widget.

REACT_APP_OPENHIVE_CHAT_CLIENT_ID="openhive_chat"
REACT_APP_OPENHIVE_CHAT_API_URI="https://openhive.chat/api/v1"
REACT_APP_OPENHIVE_CHAT_URI="https://openhive.chat"

# Enable the embedded chat iframe widget ("yes" to enable, "no" to disable)
REACT_APP_OPENHIVE_CHAT_IFRAME_INTEGRATION_ENABLE="no"

# Show/hide the widget even when enabled (for debugging)
REACT_APP_OPENHIVE_CHAT_IFRAME_VISIBLE="yes"

# Allow non-strict login (HiveAuth, etc.) users to access chat
REACT_APP_OPENHIVE_CHAT_ALLOW_NON_STRICT_LOGIN="no"

# Comma-separated list of usernames allowed to see chat widget (empty = all users)
# Use for gradual rollout: REACT_APP_OPENHIVE_CHAT_ALLOWED_USERS="gandalf,gtg,user3"
REACT_APP_OPENHIVE_CHAT_ALLOWED_USERS=""

# REQUIRED: Rocket.Chat admin credentials for token generation
# Get these from OpenHive Chat admin panel
DENSER_SERVER_OPENHIVE_CHAT_ADMIN_USER_ID="CHANGE_ME_ADMIN_USER_ID"
DENSER_SERVER_OPENHIVE_CHAT_ADMIN_USER_TOKEN="CHANGE_ME_ADMIN_USER_TOKEN"

# Secret for users.createToken API (required for RC 8.0.0+)
# Must match CREATE_TOKENS_FOR_USERS_SECRET env var on Rocket.Chat server
DENSER_SERVER_OPENHIVE_CHAT_CREATE_TOKEN_SECRET=""

# Enable auto-creation of Rocket.Chat users when they don't exist ("yes" or "no")
DENSER_SERVER_OPENHIVE_CHAT_IFRAME_CREATE_USERS="no"

# OAuth2 client secret for OpenHive Chat SSO
# Generate with: openssl rand -base64 32
# Must match the secret configured in Rocket.Chat OAuth settings
DENSER_SERVER_OAUTH_OPENHIVE_CHAT_SECRET="CHANGE_ME_GENERATE_UNIQUE_SECRET"

# =============================================================================
# Logging & Debugging
# =============================================================================
# For production, consider changing to: info/false/errors
REACT_APP_LOGGING_LOG_LEVEL="debug"
DEBUG_API_CALLS=true
DEBUG_API_LEVEL=all
DEBUG_API_SLOW_THRESHOLD=1000

# =============================================================================
# Google Drive Integration
# =============================================================================
REACT_APP_GOOGLE_DRIVE_CLIENT_ID=1000000000000-xxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxx-xxxxxxxxxxx

# =============================================================================
# MetaMask Snap Configuration
# =============================================================================
# REACT_APP_METAMASK_SNAP_VERSION=1.7.0
# REACT_APP_METAMASK_SNAP_LOCATION=local:http://localhost:8080 # For local development

# =============================================================================
# Sentry Error Tracking - leave empty to disable
# =============================================================================
REACT_APP_SENTRY_DSN=
SENTRY_AUTH_TOKEN=sntrys_ey...

# SECURITY: Set to 'true' only for local development debugging.
# Leave 'false' for staging/production to avoid PII collection.
# When true, Sentry captures IP addresses, cookies, and HTTP headers.
REACT_APP_SENTRY_SEND_PII=false
