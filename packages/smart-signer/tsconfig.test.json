{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["mocha", "node", "chai"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": "."
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
